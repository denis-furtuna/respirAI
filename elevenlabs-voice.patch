diff --git a/app/tests/voice.html b/app/tests/voice.html
new file mode 100644
index 0000000..bd06976
--- /dev/null
+++ b/app/tests/voice.html
@@ -0,0 +1,104 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>voice test</title>
+<!-- The recorded voice (voice.js): a clip is played when its text is the one on screen, else the phone's own voice; Stop cuts it.
+     The recordings and the manifest are stand-ins made here, so this needs no ElevenLabs clips. Run with app/tests/run.py. -->
+<pre id="out">running</pre>
+<iframe id="app" style="width:390px;height:844px"></iframe>
+<script type="module">
+import { CLIPS, spokenText } from "/voice.js";
+import { LANGUAGES } from "/i18n/index.js";
+const out = [];
+const check = (name, ok, extra = "") => out.push(`${ok ? "PASS" : "FAIL"} ${name} ${extra}`);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+// --- every clip is made of texts that exist, in every language, as plain text ---
+const dicts = Object.fromEntries(await Promise.all(LANGUAGES.map(async ({ code }) => [code, (await import(`/i18n/${code}.js`)).default])));
+const bad = [];
+for (const [code, dict] of Object.entries(dicts)) for (const keys of Object.values(CLIPS)) for (const key of keys) if (typeof dict[key] !== "string") bad.push(`${code}: ${key}`);
+check("every spoken sentence has a text in every language", bad.length === 0 && Object.keys(CLIPS).length === 15, bad.slice(0, 5).join("; "));
+const text = (lang, id) => spokenText(id, (key) => dicts[lang][key]);
+
+// --- the app, with a stand-in manifest, recordings and audio player ---
+localStorage.clear();
+localStorage.setItem("respirai", JSON.stringify({ server: location.origin, seconds: 5, demo: "", welcomed: true, lang: "en" }));
+const frame = document.getElementById("app");
+frame.src = "/index.html";
+await new Promise((r) => (frame.onload = r));
+const w = frame.contentWindow, d = frame.contentDocument, $ = (id) => d.getElementById(id);
+const visible = (id) => !$(id).hidden;
+
+const recorded = { en: Object.fromEntries(Object.keys(CLIPS).map((id) => [id, text("en", id)])) };
+recorded.en["point.Tc"] = "An older wording of this sentence.";   // its text has changed since it was recorded
+delete recorded.en["overall.warn"];                               // never recorded
+const fetched = [], realFetch = w.fetch.bind(w);
+w.fetch = (url, ...rest) => {
+  const path = String(url);
+  if (path === "voice/manifest.json") return Promise.resolve(new Response(JSON.stringify({ clips: recorded })));
+  if (path.startsWith("voice/")) { fetched.push(path); return Promise.resolve(new Response(new Blob(["mp3"]), { status: path.includes("breatheNext") ? 404 : 200 })); }
+  return realFetch(url, ...rest);
+};
+const urls = new Map(), realCreate = w.URL.createObjectURL.bind(w.URL);
+w.URL.createObjectURL = (blob) => { const u = realCreate(blob); urls.set(u, fetched[urls.size]); return u; };
+const played = [];   // the clips the player was asked for, in order
+let player = null, refuse = false;
+w.Audio = class {
+  play() { player = this; this.playing = true; played.push(urls.get(this.src)); return refuse ? Promise.reject(new DOMException("no", "NotAllowedError")) : Promise.resolve(); }
+  pause() { this.playing = false; this.paused = (this.paused || 0) + 1; }
+  end() { this.playing = false; this.onended?.(); }
+};
+const spoken = [];   // what the phone's own voice was asked to say
+let cancelled = 0;
+w.speechSynthesis.speak = (u) => { spoken.push(u.text); setTimeout(() => u.onend?.(), 50); };
+w.speechSynthesis.cancel = () => { cancelled++; };
