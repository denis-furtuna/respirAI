+spoken.length = 0; refuse = true;
+$("btnVoice").click(); await sleep(100); $("btnVoice").click(); await sleep(300);
+check("the player refuses → the phone's voice", spoken.join() === text("en", "voiceOn"), spoken.join());
+refuse = false;
