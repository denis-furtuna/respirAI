+check("this language's clips are fetched ahead", ["voice/en/point.Al.mp3", "voice/en/breathe.mp3", "voice/en/overall.ok.mp3"].every((f) => fetched.includes(f)) && !fetched.some((f) => !f.startsWith("voice/en/")), fetched.length + " fetched");
