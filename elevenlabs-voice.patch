+// another language without recordings: its texts, the phone's voice
+spoken.length = 0;
+$("btnVoice").click(); await sleep(100);
+$("btnSettings").click(); $("btnLangRow").click();
+[...d.querySelectorAll("#languageList .language")].find((b) => b.lang === "ro").click(); await sleep(500);
