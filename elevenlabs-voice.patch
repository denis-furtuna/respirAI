+// the whole quick test: the place's clip, then (a clip that can't be loaded) the phone's voice, then the result
+spoken.length = 0;
+await sleep(600);   // a tap right after a change of screen is ignored
+$("btnQuick").click(); await sleep(600);
+check("the place: its recorded sentence", played.at(-1) === "voice/en/point.Al.mp3" && spoken.length === 0, played.at(-1) + " / " + spoken.join());
+player.end();
+$("btnNow").click(); await sleep(400);
+check("a new check starts with the practice sentence again", played.at(-1) === "voice/en/breathe.mp3", played.at(-1));
