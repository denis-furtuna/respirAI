+$("btnVoice").click(); await sleep(300);
+check("a language with no recordings → the phone's voice, in that language", spoken.join() === "Instrucțiunile vorbite sunt pornite." && played.length === playedBefore, spoken.join());
+$("btnVoice").click();
+check("voice off → silence", cancelled > 0 && $("btnVoice").getAttribute("aria-pressed") === "false");
