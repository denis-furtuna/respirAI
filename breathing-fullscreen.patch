--- a/app/style.css
+++ b/app/style.css
@@ -151,6 +151,14 @@ main { max-width: 520px; margin: 0 auto; padding: 12px 20px 28px; }
 @keyframes halo { from { transform: scale(1); opacity: 0.9; } to { transform: scale(2.4); opacity: 0; } }
 
 .dial { position: relative; aspect-ratio: 1; width: 100%; }
+/* Once the chest piece is in place, only the breathing circle matters: it takes the whole screen until the recording is done. */
+#sPoint.breathing > .progress, #sPoint.breathing > .eyebrow, #sPoint.breathing > h1, #sPoint.breathing > .lead,
+#sPoint.breathing > .spacer, #sPoint.breathing .body { display: none; }
+#sPoint.breathing .stage { flex: 1; grid-template-columns: 1fr; justify-items: center; background: none; box-shadow: none; padding: 0; }
+#sPoint.breathing .dial { width: min(100%, 60dvh); }
+#sPoint.breathing #dialMain { font-size: 4.5rem; }
+#sPoint.breathing #dialMain.word { font-size: 2.2rem; }
+#sPoint.breathing #dialSub { font-size: 1.1rem; margin-top: 10px; }
 .dial svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
 .dial circle { fill: none; stroke-width: 8; }
 .dial .track { stroke: var(--primary-soft); }
