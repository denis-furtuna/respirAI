   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "AD8232 ECG:  OUTPUT → D0, LO+ → D2, 3.3v → 3V3, GND → GND\n             LO− and SDN unconnected (no pin left)\nMAX30102:    SDA → D4, SCL → D5, VIN → 3V3, GND → GND, INT unconnected",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "AD8232 ECG:  OUTPUT → D0, LO+ → D2, 3.3v → 3V3, GND → GND\n             LO− and SDN unconnected (no pin left)\nMAX30102:    SDA → D4, SCL → D5, VIN → 3V3, GND → GND, INT unconnected",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
