  {
   "id": "e184",
   "type": "text",
   "x": 1440,
   "y": 192,
   "width": 366.59999999999997,
   "height": 195.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1456645773,
   "version": 1,
   "versionNonce": 1794266953,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "XIAO 3V3          → mic VDD\nXIAO GND          → mic GND\nXIAO D8  (GPIO7)  → mic SCK\nXIAO D9  (GPIO8)  → mic WS\nXIAO D10 (GPIO9)  → mic SD\nmic L/R           → mic GND\nXIAO D6 (GPIO43) → 100 Ω → LED trachea → GND\nXIAO D7 (GPIO44) → 100 Ω → LED left lobe → GND\n                 → 100 Ω → LED right lobe → GND\nXIAO D3 (GPIO4)  → 100 Ω → LED “AI” → GND\nbattery + → switch → XIAO BAT+\nbattery −          → XIAO BAT−",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "XIAO 3V3          → mic VDD\nXIAO GND          → mic GND\nXIAO D8  (GPIO7)  → mic SCK\nXIAO D9  (GPIO8)  → mic WS\nXIAO D10 (GPIO9)  → mic SD\nmic L/R           → mic GND\nXIAO D6 (GPIO43) → 100 Ω → LED trachea → GND\nXIAO D7 (GPIO44) → 100 Ω → LED left lobe → GND\n                 → 100 Ω → LED right lobe → GND\nXIAO D3 (GPIO4)  → 100 Ω → LED “AI” → GND\nbattery + → switch → XIAO BAT+\nbattery −          → XIAO BAT−",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e185",
   "type": "text",
   "x": 1440,
   "y": 420,
   "width": 209.00000000000003,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
