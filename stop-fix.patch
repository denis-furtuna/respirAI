From 93879337fd5ab565240b4da0c638cfc30393069f Mon Sep 17 00:00:00 2001
From: George Haragos <george.haragos.6@gmail.com>
Date: Fri, 13 Nov 2026 23:16:44 +0200
Subject: [PATCH] App: Stop works at once in every phase, also while an
 instruction is being spoken
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With spoken instructions on, the check waited for "Get ready, breathe slowly…" to be
said in full (up to 8 s) before it looked at Stop, and the voice kept talking.
Stop, the back button, a lost device and the app going to the background now all go
through stopSession(): it cuts the voice and that wait, then the check stops.

Tests: stop during the practice breath, and stop mid-sentence with a voice that never
finishes (fails on the old code).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AQ3BxL1wi4KCaN2LJLooH6
---
 app/app.js          | 19 ++++++++++++++-----
 app/tests/flow.html | 16 ++++++++++++++++
 2 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/app/app.js b/app/app.js
index 0232081..b0b869f 100644
--- a/app/app.js
+++ b/app/app.js
@@ -198,7 +198,7 @@ async function lostDevice(d) {
   battery = null;
   showBattery();
   notice("device.reconnecting");
-  if (running) cancel = true;
+  if (running) stopSession();
   else if (!$("sReady").hidden) show("sConnect");   // results stay on screen if they are showing
   for (const wait of [500, 1500, 3000, 5000]) {
     await sleep(wait);
@@ -230,6 +230,15 @@ function send(bytes) {
 // { id, started, codes: the places of this check (all 7, or QUICK), quick, results: {code: response}, audio: {code: Int16Array}, pending: [] }
 let session = null;
 let running = false, cancel = false, skip = false, lock = null;
+let wake = () => {};   // cuts short the one wait that is not a countdown: the spoken instruction before a recording
+
+// Stop button, back button, a lost device, the app going to the background: stop now, also mid-sentence.
+function stopSession() {
+  cancel = true;
+  hush();
+  wake();
+}
+const orStop = (wait) => Promise.race([wait, new Promise((r) => { wake = r; })]);
 
 const places = () => (session ? session.codes : ORDER);
 const remaining = () => places().filter((c) => !session?.results[c]);
@@ -246,7 +255,7 @@ function away() {
   stopListening();
   hush();
   if (running && !$("sPoint").hidden) {   // a phone call, or the screen switched off: pause rather than record nothing
-    cancel = true;
+    stopSession();
     notice("device.paused");
   }
 }
@@ -260,7 +269,7 @@ addEventListener("beforeunload", (e) => {
 });
 
 // Android's back button stops a recording instead of leaving the page.
-addEventListener("popstate", () => { if (running) cancel = true; });
+addEventListener("popstate", () => { if (running) stopSession(); });
 const catchBack = () => { if (history.state !== "check") history.pushState("check", ""); };
 
 async function runSession(codes) {
@@ -319,7 +328,7 @@ async function recordPoint(code) {
   // Continue or Record again) start recording with the first breath.
   const practice = !session.practised;
   dial(t("point.getReady"), t("point.breatheSlowly"), 0);
-  await say(t(practice ? "point.sayBreathe" : "point.sayBreatheNext"));   // finishes before the recording starts
+  await orStop(say(t(practice ? "point.sayBreathe" : "point.sayBreatheNext")));   // finishes before the recording starts, unless stopped
   if (cancel) return;
 
   // 2. (The practice breath, then) record the next breaths. The device's lights start with the circle and loop on
@@ -737,7 +746,7 @@ $("btnQuick").addEventListener("click", () => {   // one place, then its result
   runSession(QUICK);
 });
 $("btnNow").addEventListener("click", () => { if (settled()) skip = true; });
-$("btnStop").addEventListener("click", () => { if (settled()) cancel = true; });
+$("btnStop").addEventListener("click", () => { if (settled() && running) stopSession(); });
 $("btnRestart").addEventListener("click", () => {
   const since = performance.now() - armedAt;
   if (since < 400) return;   // the two taps of a double-tap count as one
diff --git a/app/tests/flow.html b/app/tests/flow.html
index 1db2b0e..e12238d 100644
--- a/app/tests/flow.html
+++ b/app/tests/flow.html
@@ -149,6 +149,22 @@ $("btnBegin").click(); await sleep(1000); frame.contentWindow.history.back(); aw
 check("phone back button during a recording → back to ready, page kept", visible("sReady") && frame.contentWindow.location.pathname === "/index.html");
 $("btnBegin").click(); await sleep(1000); $("btnStop").click(); await sleep(500);
 check("stop → back to ready", visible("sReady"));
+$("btnBegin").click(); await sleep(600); $("btnNow").click(); await sleep(2000);
+const breathingNow = $("dialSub").textContent;
+$("btnStop").click(); await sleep(300);
+check("stop during the practice breath → back to ready at once", visible("sReady"), breathingNow);
+$("btnVoice").click();   // voice on, and a voice that never finishes its sentence
+let hushed = 0;
+const realSpeak = w.speechSynthesis.speak.bind(w.speechSynthesis), realCancel = w.speechSynthesis.cancel.bind(w.speechSynthesis);
+w.speechSynthesis.speak = () => {};
+w.speechSynthesis.cancel = () => { hushed++; };
+await sleep(500);
+$("btnBegin").click(); await sleep(600); $("btnNow").click(); await sleep(500);
+const before = hushed;
+$("btnStop").click(); await sleep(300);
+check("stop while the instruction is being spoken → back to ready at once, voice cut", visible("sReady") && hushed > before);
+w.speechSynthesis.speak = realSpeak; w.speechSynthesis.cancel = realCancel;
+$("btnVoice").click();
 $("textSize").value = "130"; $("textSize").dispatchEvent(new Event("change"));
 check("text size setting", d.documentElement.style.fontSize === "130%" && parseFloat(getComputedStyle(d.body).fontSize) > 24, getComputedStyle(d.body).fontSize);
 $("textSize").value = "100"; $("textSize").dispatchEvent(new Event("change"));
