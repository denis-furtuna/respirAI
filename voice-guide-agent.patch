index 0000000..719dd1a
--- /dev/null
+++ b/app/tests/guide.html
@@ -0,0 +1,143 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>voice guide test</title>
+<!-- The voice guide (guide.js) over the normal flow, with a stand-in for the ElevenLabs agent: what the app tells it, what its
+     tools do, silence and a muted microphone while recording, and the check going on without it. Run with app/tests/run.py. -->
+<pre id="out">running</pre>
+<iframe id="app" style="width:390px;height:844px"></iframe>
+<script type="module">
+const out = [];
+const check = (name, ok, extra = "") => out.push(`${ok ? "PASS" : "FAIL"} ${name} ${extra}`);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const frame = document.getElementById("app");
+let w, d, $, visible, spoken, Agent;
+
+// The stand-in agent: answers every message from the app (and every tool result) by "speaking" for a moment.
+function standIn() {
+  return class Fake {
+    static calls = [];
+    static refuse = () => false;   // (options) → true: startSession fails
+    static async startSession(options) {
+      Fake.calls.push(options);
+      if (Fake.refuse(options)) throw new Error("refused");
+      return (Fake.last = new Fake(options));
+    }
+    constructor(options) { Object.assign(this, { options, messages: [], muted: false, volume: 1, ended: false }); }
+    speak(ms = 700) {
+      setTimeout(() => this.ended || this.options.onModeChange({ mode: "speaking" }), 50);
+      setTimeout(() => this.ended || this.options.onModeChange({ mode: "listening" }), 50 + ms);
+    }
+    sendUserMessage(text) { this.messages.push(text); this.speak(); }
+    setMicMuted(muted) { this.muted = muted; }
+    setVolume({ volume }) { this.volume = volume; }
+    async endSession() { this.ended = true; this.options.onDisconnect?.({ reason: "user" }); }
+    drop() { this.ended = true; this.options.onDisconnect({ reason: "error" }); }
+    async tool(name) { const answer = await this.options.clientTools[name]({}); this.speak(1500); return answer; }
+  };
+}
+
+async function open(query = "") {
+  frame.src = "/index.html" + query;
+  await new Promise((r) => (frame.onload = r));
+  w = frame.contentWindow; d = frame.contentDocument; $ = (id) => d.getElementById(id);
+  visible = (id) => !$(id).hidden;
+  spoken = [];
+  w.speechSynthesis.speak = (u) => { spoken.push(u.text); setTimeout(() => u.onend?.(), 50); };
+  w.speechSynthesis.cancel = () => {};
+  w.navigator.mediaDevices.getUserMedia = async () => ({ getTracks: () => [] });
+  const realFetch = w.fetch.bind(w);   // no recorded clips here: what the guide doesn't say, the phone's own voice says
+  w.fetch = (url, ...rest) => (String(url) === "voice/manifest.json" ? Promise.resolve(new Response("{}")) : realFetch(url, ...rest));
+  Agent = w.respiraiGuideSdk = { Conversation: standIn() };
+  Agent = Agent.Conversation;
+  await sleep(300);
+  $("btnPractice").click(); await sleep(1100);
+}
+const until = async (test, ms = 60000) => { for (let t0 = Date.now(); !test() && Date.now() - t0 < ms;) await sleep(100); return test(); };
+
+localStorage.clear();
+localStorage.setItem("respirai", JSON.stringify({ server: location.origin, seconds: 5, demo: "", welcomed: true, lang: "en" }));
+
+// --- no agent set up: nothing of the guide shows ---
+await open();
+check("no agent set up → no voice guide on the ready screen", visible("sReady") && !visible("btnGuide") && !visible("guideHint"));
+
+// --- an agent: a guided quick test from start to result ---
+await open("?agent=agent_test");
+check("an agent → the voice guide is offered, off, with what it sends where", visible("btnGuide") && $("btnGuide").getAttribute("aria-pressed") === "false" && /ElevenLabs/.test($("guideHint").textContent));
+w.navigator.mediaDevices.getUserMedia = async () => { throw new w.DOMException("no", "NotAllowedError"); };
+$("btnGuide").click(); await sleep(200);
+check("microphone refused → stays off, says why", $("btnGuide").getAttribute("aria-pressed") === "false" && /microphone/.test($("notice").textContent), $("notice").textContent);
+w.navigator.mediaDevices.getUserMedia = async () => ({ getTracks: () => [] });
+$("btnGuide").click(); await sleep(200);
+check("microphone allowed → on", $("btnGuide").getAttribute("aria-pressed") === "true" && !visible("notice") && Agent.calls.length === 0);
+
+await sleep(400);
+$("btnQuick").click(); await sleep(700);
+let a = Agent.last;
+const first = Agent.calls[0];
+check("a guided check opens the conversation: agent, language, the two tools", first.agentId === "agent_test" && first.overrides.agent.language === "en" && Object.keys(first.clientTools).sort().join() === "start_recording,stop_check");
+check("the agent is told the place, with the words on screen", a.messages.length === 1 && a.messages[0].startsWith("[APP] Place 1 of 1") && a.messages[0].includes($("pointTitle").textContent) && a.messages[0].includes($("pointWhere").textContent), a.messages[0]);
+check("the app's own voice stays silent", spoken.length === 0);
+await sleep(900);
+check("while placing: the guide listens, there is time to talk", $("btnGuideMic").textContent.includes("listening") && !a.muted && Number($("dialMain").textContent) > 50, $("btnGuideMic").textContent + " / " + $("dialMain").textContent);
+$("btnGuideMic").click();
+check("the chip switches the microphone off…", a.muted && $("btnGuideMic").textContent.includes("Microphone off"), $("btnGuideMic").textContent);
+$("btnGuideMic").click();
+check("…and on again", !a.muted && $("btnGuideMic").textContent.includes("listening"));
+
+const answer = await a.tool("start_recording");   // the person said "ready"
+check("the agent's start_recording: told what to say, the practice sentence", /Breathe|breath/i.test(answer) && answer.includes("practice"), answer);
+await sleep(700);
+check("the recording waits until the agent has finished speaking", $("dialMain").textContent === "Get ready" && !a.muted && a.volume === 1 && a.messages.length === 1, $("dialMain").textContent);
+await sleep(1800);
+check("while the stethoscope records: microphone off, agent silent", a.muted && a.volume === 0 && $("btnGuideMic").disabled && /Breathe/.test($("dialMain").textContent), $("dialMain").textContent + " / " + $("btnGuideMic").textContent);
+check("start_recording a second time does nothing", /Not possible/.test(await a.options.clientTools.start_recording({})));
+await until(() => visible("sResults"));
+check("after the recording: microphone and voice back", !a.muted && a.volume === 1);
+await sleep(600);
+check("the agent is told the result, with the words on screen", a.messages.length === 2 && a.messages[1].includes($("overallTitle").textContent) && a.messages[1].includes("do not name any illness"), a.messages.at(-1));
+await until(() => a.ended, 5000);
+check("result said → the conversation ends; the app's own voice never spoke", a.ended && spoken.length === 0, spoken.join());
+
+// --- start now by button: the app asks the agent to say the breathing sentence; then the agent's stop_check ---
+await open("?agent=agent_test");
+$("btnGuide").click(); await sleep(700);
+$("btnQuick").click(); await sleep(700);
+a = Agent.last;
+$("btnNow").click(); await sleep(400);
+check("start now by button → the agent is asked to say the breathing sentence", a.messages.length === 2 && a.messages[1].startsWith("[APP] The recording starts now") && a.messages[1].includes("practice"), a.messages.at(-1));
+await sleep(1500);
+check("…and is then held quiet", a.muted && a.volume === 0);
+check("the agent's stop_check", /stopped/.test(await a.options.clientTools.stop_check({})));
+await sleep(500);
+check("stop_check → back to ready, conversation ended, no complaint", visible("sReady") && a.ended && !visible("notice"));
+
+// --- the agent refuses the language override: connected without it ---
+Agent.calls.length = 0;
+Agent.refuse = (options) => !!options.overrides;
+await sleep(500);
+$("btnQuick").click(); await sleep(900);
+check("language override refused → connected without it", Agent.calls.length === 2 && !Agent.calls[1].overrides && Agent.last.messages.length === 1 && !visible("notice"), Agent.calls.length + " calls");
+
+// --- the agent goes away in the middle: the check goes on with the app's own voice ---
+a = Agent.last;
+a.drop(); await sleep(300);
+check("agent gone mid-check → said once, the check goes on", visible("sPoint") && /voice guide/.test($("notice").textContent) && !visible("btnGuideMic"), $("notice").textContent);
+$("btnNow").click(); await sleep(500);
+check("…with the app's own voice for the next sentence", spoken.length === 1 && spoken[0].includes("practice"), spoken.join());
+await until(() => visible("sResults"));
+await sleep(500);
+check("…and for the result", spoken.length === 2 && spoken[1].includes($("overallTitle").textContent), spoken.join(" | "));
+
+// --- no connection at all ---
+await open("?agent=agent_test");
+Agent.refuse = () => true;
+$("btnGuide").click(); await sleep(700);
+$("btnQuick").click(); await sleep(900);
+check("the agent can't be reached → said once, the place is read by the app's own voice", /voice guide/.test($("notice").textContent) && spoken.length === 1 && spoken[0].includes($("pointTitle").textContent), spoken.join());
+check("…and the place has its usual few seconds, not a minute", Number($("dialMain").textContent) <= 8, $("dialMain").textContent);
+$("btnStop").click();
+try { localStorage.removeItem("respirai-agent"); } catch (e) {}
+
+document.getElementById("out").textContent = out.join("\n") + "\nDONE";
+</script>
